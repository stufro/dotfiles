<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps tmux's light/dark theme in step with macOS appearance. iTerm2 doesn't
  send tmux theme reports, so tmux can't detect the change itself.

  dark-notify appends "light" or "dark" to the command on every change. A
  failing command (no tmux server running) is ignored, and .tmux.conf sets the
  theme on server start.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.tmux-theme-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/dark-notify</string>
    <string>-c</string>
    <string>/opt/homebrew/bin/tmux set -s theme</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
